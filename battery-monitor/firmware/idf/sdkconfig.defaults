# Battery Monitor authoritative ESP-IDF configuration.
# Target is set explicitly to esp32 by CI/idf.py.

# Arduino-ESP32 component requirements / behavior.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000

# Match the existing ESP32-WROOM-32 hardware assumptions.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Native ESP-IDF HTTP server migration. Battery Monitor defaults to 15 HTTP
# client sessions and allows the service-level setting to be reduced/raised at
# runtime within a bounded range. esp_http_server reserves additional sockets
# internally, while discovery/mDNS also consume lwIP descriptors, so keep the
# global descriptor ceiling comfortably above the HTTP client limit. This does
# not preallocate full TCP windows for all descriptors; per-connection memory is
# allocated on demand and runtime heap diagnostics remain part of validation.
CONFIG_LWIP_MAX_SOCKETS=30

# Flash layout. Release-mode Flash Encryption enlarges the classic ESP32
# bootloader beyond the old 0x7000-byte allowance. Keep the application
# authority fixed at app0 @ 0x10000 while moving the partition table to the
# highest 4 KiB slot below it, leaving maximum bootloader growth room for the
# later Secure Boot activation.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xF000

# P1-1 device-at-rest protection is active in the one production build.
# Release-mode Flash Encryption generates a unique device key on first boot and
# permanently disables ROM-download encryption/decryption operations. Plaintext
# application updates therefore have to be written by the running application
# (OTA/app-mediated path), not directly by esptool after encryption is active.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC is not set

# Encrypt the default NVS partition using XTS keys stored in the encrypted
# nvs_keys partition from partitions.csv. nvs_flash_init() generates the keys
# on-device when that key partition is blank.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y

# A newly selected signed OTA image gets one probationary boot. If it resets,
# loses power, or is explicitly rejected before the application confirms local
# health, the bootloader returns to the previously valid OTA slot. This is
# recoverability from a bad signed release; irreversible eFuse anti-downgrade is
# a separate policy and intentionally remains disabled.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set

# Secure Boot remains intentionally disabled until the encrypted-hardware test
# program is complete. Flash/NVS encryption and Secure Boot are separate gates.
# This is one build architecture, not a separate dev/prod firmware tree.
